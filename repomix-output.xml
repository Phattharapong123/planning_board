<file path="src/components/UnassignedDock.tsx">
import { useState, useRef, useCallback, useEffect, useMemo } from 'react';
import { createPortal } from 'react-dom';
import { Package, ArrowUpToLine, GripHorizontal, ChevronUp, ChevronDown, Pencil, Trash2, CalendarDays } from 'lucide-react';
import type { ProductionOrder } from '../types';
import PlanCard from './PlanCard';

const MIN_HEIGHT = 68;
const MAX_HEIGHT = 300;
const COLLAPSED_HEIGHT = 28;
const CARD_H_PX = 58;
const CARD_W_PX = 96; // 1.0in
// Overhead: resize-handle(16) + header(~36) + pb(8) ≈ 60px
const TWO_ROW_THRESHOLD   = 60 + CARD_H_PX * 2 + 8;    // ~184px
const THREE_ROW_THRESHOLD = 60 + CARD_H_PX * 3 + 8 * 2; // ~250px

interface CardActions {
  canEditCard: (o: ProductionOrder) => boolean;
  canConfirmCards: boolean;
  canPlanCards: boolean;
  canDeleteCard: (o: ProductionOrder) => boolean;
  canFinishCards: boolean;
  onEdit: (o: ProductionOrder) => void;
  onConfirm: (o: ProductionOrder) => void;
  onPlan: (o: ProductionOrder) => void;
  onEditPlanDate: (o: ProductionOrder) => void;
  onUnplan: (o: ProductionOrder) => void;
  onDelete: (o: ProductionOrder) => void;
  onFinish: (o: ProductionOrder) => void;
  onPrint: (o: ProductionOrder) => void;
}

interface Props extends CardActions {
  orders: ProductionOrder[];
  draggingId: string | null;
  searchText: string;
  dockHeight: number;
  isDark?: boolean;
  highlightedId?: string | null;
  onHeightChange: (h: number) => void;
  onCardDragStart: (e: React.DragEvent, order: ProductionOrder) => void;
  onCardDragEnd: () => void;
  onDockDrop: (e: React.DragEvent) => void;
}

// ── UserFilter — custom dropdown for creator filtering ────────────────────────
function UserFilter({ creators, value, onChange }: { creators: string[]; value: string; onChange: (v: string) => void }) {
  const [open, setOpen] = useState(false);
  const [rect, setRect] = useState<DOMRect | null>(null);
  const btnRef = useRef<HTMLButtonElement>(null);

  useEffect(() => {
    if (!open) return;
    const h = () => setOpen(false);
    const t = setTimeout(() => document.addEventListener('mousedown', h), 0);
    return () => { clearTimeout(t); document.removeEventListener('mousedown', h); };
  }, [open]);

  function handleToggle() {
    if (!open && btnRef.current) setRect(btnRef.current.getBoundingClientRect());
    setOpen(v => !v);
  }

  return (
    <>
      <button
        ref={btnRef}
        onClick={handleToggle}
        className="flex items-center gap-1 text-[10px] font-semibold bg-white/10 hover:bg-white/20 text-gray-200 border border-white/20 hover:border-brand-orange/60 rounded-md px-2 py-0.5 transition-colors"
      >
        {value === 'All' ? 'All Users' : value}
        <ChevronDown size={8} className={`transition-transform ${open ? 'rotate-180' : ''}`} />
      </button>
      {open && rect && createPortal(
        <div
          style={{
            position: 'fixed',
            bottom: window.innerHeight - rect.top + 4,
            left: rect.left,
            zIndex: 999999,
          }}
          className="bg-[#0C1830] border border-blue-900/60 rounded-lg shadow-2xl overflow-hidden min-w-[130px]"
          onMouseDown={e => e.stopPropagation()}
        >
          {(['All', ...creators] as string[]).map(c => (
            <button
              key={c}
              onMouseDown={() => { onChange(c); setOpen(false); }}
              className={`w-full text-left px-3 py-1.5 text-[10px] font-medium flex items-center justify-between gap-2 transition-colors ${
                value === c
                  ? 'bg-brand-orange/20 text-brand-orange font-bold'
                  : 'text-gray-200 hover:bg-white/10 hover:text-white'
              }`}
            >
              {c === 'All' ? 'All Users' : c}
              {value === c && <span className="text-brand-orange text-[9px]">✓</span>}
            </button>
          ))}
        </div>,
        document.body
      )}
    </>
  );
}

// ── DockFloatingCard — portal zoom+menu for cards in Unplanned bar ────────────
function DockFloatingCard({
  order, isDark, actions,
  onDragStart, onDragEnd, isDragging,
}: {
  order: ProductionOrder;
  isDark: boolean;
  actions: CardActions;
  onDragStart: (e: React.DragEvent, o: ProductionOrder) => void;
  onDragEnd: () => void;
  isDragging: boolean;
}) {
  const [expanded, setExpanded] = useState(false);
  const [cardRect, setCardRect] = useState<DOMRect | null>(null);
  const [animReady, setAnimReady] = useState(false);
  const origRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (expanded) {
      const t = requestAnimationFrame(() => setAnimReady(true));
      return () => cancelAnimationFrame(t);
    } else {
      setAnimReady(false);
    }
  }, [expanded]);

  function handleClick(e: React.MouseEvent) {
    e.stopPropagation();
    if (!expanded && origRef.current) {
      setCardRect(origRef.current.getBoundingClientRect());
    }
    setExpanded(v => !v);
  }

  // Portal card position: bottom-center aligned to original, scaled 1.5×
  const expandScale = 1.5;
  const portalCardTop  = cardRect ? cardRect.top  + CARD_H_PX - CARD_H_PX : 0;
  const portalCardLeft = cardRect ? cardRect.left + CARD_W_PX / 2 - CARD_W_PX / 2 : 0;
  const scaledCenterX  = cardRect ? cardRect.left + CARD_W_PX / 2 : 0;
  const scaledTopY     = cardRect ? cardRect.top  + CARD_H_PX - CARD_H_PX * expandScale : 0;

  const btnStyle = (bg: string): React.CSSProperties => ({
    display: 'flex', alignItems: 'center', gap: 3,
    padding: '3px 7px', borderRadius: 5,
    background: bg, color: '#fff',
    fontSize: 10, fontWeight: 700, border: 'none', cursor: 'pointer',
    boxShadow: '0 2px 8px rgba(0,0,0,0.3)',
    whiteSpace: 'nowrap',
  });

  const portalContent = expanded && cardRect ? createPortal(
    <div style={{ position: 'fixed', top: 0, left: 0, width: '100%', height: '100%', zIndex: 99999, pointerEvents: 'none' }}>
      {/* Backdrop */}
      <div style={{ position: 'absolute', inset: 0, pointerEvents: 'auto' }} onMouseDown={() => setExpanded(false)} />
      {/* Scaled card */}
      <div
        style={{
          position: 'absolute',
          top: portalCardTop,
          left: portalCardLeft,
          transformOrigin: 'bottom center',
          transform: animReady ? `scale(${expandScale})` : 'scale(1)',
          transition: 'transform 0.18s cubic-bezier(0.34,1.56,0.64,1), filter 0.15s ease',
          filter: animReady ? 'drop-shadow(0 6px 18px rgba(0,0,0,0.35))' : 'none',
          pointerEvents: 'auto',
          zIndex: 2,
        }}
        onMouseDown={e => e.stopPropagation()}
        onClick={() => setExpanded(false)}
      >
        <PlanCard order={order} isDragging={false} isDark={isDark} />
      </div>
      {/* Action buttons above scaled card */}
      <div
        style={{
          position: 'absolute',
          top: scaledTopY - 30,
          left: scaledCenterX,
          transform: 'translateX(-50%)',
          display: 'flex', gap: 3, pointerEvents: 'auto', zIndex: 3,
          opacity: animReady ? 1 : 0,
          transition: 'opacity 0.12s ease',
        }}
        onMouseDown={e => e.stopPropagation()}
      >
        {actions.canEditCard(order) && (
          <button onMouseDown={e => { e.stopPropagation(); actions.onEdit(order); setExpanded(false); }} style={btnStyle('#F36B21')}>
            <Pencil size={9} /> Edit
          </button>
        )}
        {actions.canPlanCards && !order.urgent && (
          order.is_planned
            ? <button onMouseDown={e => { e.stopPropagation(); actions.onUnplan(order); setExpanded(false); }} style={btnStyle('#6B7280')}>↩ UNPLAN</button>
            : <button onMouseDown={e => { e.stopPropagation(); actions.onPlan(order); setExpanded(false); }} style={btnStyle('#0F766E')}>✓ PLAN</button>
        )}
        {actions.canPlanCards && (
          <button onMouseDown={e => { e.stopPropagation(); actions.onEditPlanDate(order); setExpanded(false); }} style={btnStyle('#0F766E')}>
            <CalendarDays size={9} /> {order.plan_issue_date ? 'Edit Date' : 'Set Date'}
          </button>
        )}
        {actions.canFinishCards && (
          <button onMouseDown={e => { e.stopPropagation(); actions.onFinish(order); setExpanded(false); }} style={btnStyle('#1D4ED8')}>✓ FINISHED</button>
        )}
        {actions.canFinishCards && !order.is_planned && (
          <button onMouseDown={e => { e.stopPropagation(); actions.onPrint(order); setExpanded(false); }} style={btnStyle(order.is_printed ? '#6B7280' : '#7C3AED')}>
            {order.is_printed ? 'Cancel P' : 'Press P'}
          </button>
        )}
        {actions.canDeleteCard(order) && (
          <button onMouseDown={e => { e.stopPropagation(); actions.onDelete(order); setExpanded(false); }} style={btnStyle('#DC2626')}>
            <Trash2 size={9} /> Del
          </button>
        )}
        <button onMouseDown={e => { e.stopPropagation(); setExpanded(false); }} style={btnStyle('#374151')}>×</button>
      </div>
    </div>,
    document.body
  ) : null;

  return (
    <>
      <div ref={origRef} style={{ opacity: isDragging ? 0 : 1 }}>
        <div onClick={handleClick} style={{ cursor: 'pointer' }}>
          <PlanCard
            order={order}
            onDragStart={onDragStart}
            onDragEnd={onDragEnd}
            isDragging={isDragging}
            isDark={isDark}
          />
        </div>
      </div>
      {portalContent}
    </>
  );
}

// ── UnassignedDock ────────────────────────────────────────────────────────────
export default function UnassignedDock({
  orders, draggingId, searchText, dockHeight, isDark = false,
  highlightedId = null,
  onHeightChange, onCardDragStart, onCardDragEnd, onDockDrop,
  canEditCard, canConfirmCards, canPlanCards, canDeleteCard, canFinishCards,
  onEdit, onConfirm, onPlan, onEditPlanDate, onUnplan, onDelete, onFinish, onPrint,
}: Props) {
  const [dropHover, setDropHover]       = useState(false);
  const [manualExpanded, setManualExpanded] = useState(false);
  const [filterUser, setFilterUser]     = useState('All');
  const dragStartY = useRef<number | null>(null);
  const dragStartH = useRef<number>(dockHeight);
  const prevOrderCount = useRef(orders.length);
  const cardsAreaRef = useRef<HTMLDivElement>(null);

  const isReturnDrag = draggingId !== null && orders.every(o => o.id !== draggingId);

  // Auto-scroll to highlighted card in dock
  useEffect(() => {
    if (!highlightedId || !cardsAreaRef.current) return;
    const scrollable = cardsAreaRef.current.querySelector('.dock-scroll') as HTMLElement;
    const el = cardsAreaRef.current.querySelector(`[data-card-id="${highlightedId}"]`) as HTMLElement;
    if (el && scrollable) {
      const elLeft = el.offsetLeft;
      const elWidth = el.offsetWidth;
      const containerWidth = scrollable.clientWidth;
      scrollable.scrollTo({ left: Math.max(0, elLeft - containerWidth / 2 + elWidth / 2), behavior: 'smooth' });
    }
  }, [highlightedId]);

  useEffect(() => {
    if (prevOrderCount.current === 0 && orders.length > 0) {
      setManualExpanded(false);
    }
    prevOrderCount.current = orders.length;
  }, [orders.length]);

  const isCollapsed = orders.length === 0 && !isReturnDrag && !manualExpanded;

  function matchesSearch(o: ProductionOrder): boolean {
    if (!searchText.trim()) return true;
    const s = searchText.toLowerCase();
    return [o.unc_code_1, o.unc_code_2, o.unc_code_3, o.unc_code_4, o.order_id]
      .some(v => v?.toLowerCase().includes(s));
  }

  const creators = useMemo(() => {
    const set = new Set(orders.map(o => o.created_by).filter(Boolean) as string[]);
    return Array.from(set).sort();
  }, [orders]);

  const visibleOrders = useMemo(() => {
    if (filterUser === 'All') return orders;
    return orders.filter(o => o.created_by === filterUser);
  }, [orders, filterUser]);

  const handleResizeMouseDown = useCallback((e: React.MouseEvent) => {
    e.preventDefault();
    dragStartY.current = e.clientY;
    dragStartH.current = dockHeight;

    function onMove(mv: MouseEvent) {
      if (dragStartY.current === null) return;
      const delta = dragStartY.current - mv.clientY;
      const newH = Math.min(MAX_HEIGHT, Math.max(MIN_HEIGHT, dragStartH.current + delta));
      onHeightChange(newH);
    }
    function onUp() {
      dragStartY.current = null;
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
    }
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  }, [dockHeight, onHeightChange]);

  const effectiveHeight = isCollapsed ? COLLAPSED_HEIGHT : dockHeight;

  // Multi-row layout when dock is tall enough
  const rowCount = !isCollapsed && dockHeight >= THREE_ROW_THRESHOLD ? 3
                 : !isCollapsed && dockHeight >= TWO_ROW_THRESHOLD   ? 2
                 : 1;
  const multiRow = rowCount > 1;

  const actions: CardActions = {
    canEditCard, canConfirmCards, canPlanCards, canDeleteCard, canFinishCards,
    onEdit, onConfirm, onPlan, onEditPlanDate, onUnplan, onDelete, onFinish, onPrint,
  };

  return (
    <div
      className={`
        flex-shrink-0 rounded-2xl overflow-hidden flex flex-col
        border-2 transition-all duration-300
        ${dropHover && isReturnDrag
          ? 'border-brand-orange bg-brand-orange/10'
          : 'border-brand-black bg-brand-black'}
      `}
      style={{ height: effectiveHeight }}
      onDragOver={(e) => { e.preventDefault(); setDropHover(true); }}
      onDragLeave={() => setDropHover(false)}
      onDrop={(e) => { setDropHover(false); onDockDrop(e); }}
    >
      {/* Resize handle */}
      {!isCollapsed && (
        <div
          onMouseDown={handleResizeMouseDown}
          className="flex items-center justify-center h-4 flex-shrink-0 cursor-ns-resize hover:bg-white/10 transition-colors group"
          title="Drag to resize"
        >
          <GripHorizontal size={12} className="text-gray-600 group-hover:text-gray-400 transition-colors" />
        </div>
      )}

      {/* Header */}
      <div className="flex items-center gap-3 px-4 py-1.5 flex-shrink-0 flex-wrap" style={{ paddingTop: isCollapsed ? 4 : undefined, paddingBottom: isCollapsed ? 4 : undefined }}>
        <div className="flex items-center gap-2">
          <Package size={12} className="text-brand-orange" />
          <span className="text-[11px] font-bold text-gray-300 uppercase tracking-widest">Unplanned</span>
          <span className="bg-brand-orange text-white text-[10px] font-extrabold px-1.5 py-0.5 rounded-full min-w-[20px] text-center">
            {visibleOrders.length}
          </span>
          {multiRow && (
            <span className="text-[9px] text-gray-600 font-medium">{rowCount} rows</span>
          )}
        </div>

        {/* User filter dropdown */}
        {!isCollapsed && creators.length > 0 && (
          <UserFilter creators={creators} value={filterUser} onChange={setFilterUser} />
        )}

        {isReturnDrag && dropHover ? (
          <span className="flex items-center gap-1.5 text-xs text-brand-orange font-semibold animate-pulse">
            <ArrowUpToLine size={11} />
            Drop here to return to pool
          </span>
        ) : draggingId && !isReturnDrag ? (
          <span className="text-[11px] text-gray-500">Dragging from pool...</span>
        ) : visibleOrders.length > 0 ? null : (
          <div className="flex items-center gap-2">
            <span className="text-[11px] text-green-400 font-semibold">
              {filterUser === 'All' ? 'All plans placed on board' : `No unplanned cards for ${filterUser}`}
            </span>
            {filterUser === 'All' && (
              <button
                onClick={() => setManualExpanded(v => !v)}
                className="text-gray-500 hover:text-gray-300 transition-colors"
                title={manualExpanded ? 'Collapse' : 'Expand'}
              >
                <ChevronUp size={12} className={`transition-transform ${manualExpanded ? '' : 'rotate-180'}`} />
              </button>
            )}
          </div>
        )}
      </div>

      {/* Cards area */}
      {!isCollapsed && (
        <div ref={cardsAreaRef} className="flex-1 min-h-0 px-3 pb-2 overflow-hidden">
          {visibleOrders.length === 0 ? (
            <div className="flex items-center justify-center h-full text-gray-600 text-xs">
              No unplanned cards
            </div>
          ) : multiRow ? (
            // Multi-row grid: fill top row first, then overflow to next rows
            (() => {
              const cardsPerRow = Math.ceil(visibleOrders.length / rowCount);
              return (
                <div
                  className="dock-scroll overflow-x-auto overflow-y-hidden h-full"
                  style={{
                    display: 'grid',
                    gridAutoFlow: 'row',
                    gridTemplateColumns: `repeat(${cardsPerRow}, ${CARD_W_PX}px)`,
                    gridTemplateRows: `repeat(${rowCount}, ${CARD_H_PX}px)`,
                    gap: 8,
                    alignContent: 'center',
                  }}
                >
              {visibleOrders.map(order => {
                const dim = !!searchText.trim() && !matchesSearch(order);
                const isHlit = highlightedId === order.id;
                return (
                  <div key={order.id} data-card-id={order.id} style={{ opacity: dim ? 0.25 : 1, transition: 'opacity 0.15s', outline: isHlit ? '2px solid #F36B21' : 'none', outlineOffset: '2px', borderRadius: 4 }}>
                    <DockFloatingCard
                      order={order}
                      isDark={isDark}
                      actions={actions}
                      onDragStart={onCardDragStart}
                      onDragEnd={onCardDragEnd}
                      isDragging={draggingId === order.id}
                    />
                  </div>
                );
              })}
                </div>
              );
            })()
          ) : (
            // Single-row scroll layout
            <div className="dock-scroll flex gap-2 h-full items-center overflow-x-auto overflow-y-hidden">
              {visibleOrders.map(order => {
                const dim = !!searchText.trim() && !matchesSearch(order);
                const isHlit = highlightedId === order.id;
                return (
                  <div key={order.id} data-card-id={order.id} style={{ opacity: dim ? 0.25 : 1, transition: 'opacity 0.15s', flexShrink: 0, outline: isHlit ? '2px solid #F36B21' : 'none', outlineOffset: '2px', borderRadius: 4 }}>
                    <DockFloatingCard
                      order={order}
                      isDark={isDark}
                      actions={actions}
                      onDragStart={onCardDragStart}
                      onDragEnd={onCardDragEnd}
                      isDragging={draggingId === order.id}
                    />
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/UserManagement.tsx">
import { useState, useEffect, useCallback } from 'react';
import { Plus, Pencil, Trash2, X, User, Shield, RefreshCw, Save, Eye, EyeOff } from 'lucide-react';
import { supabase } from '../lib/supabase';
import { useAuth } from '../contexts/AuthContext';
import type { SectionAccess } from '../types';

type UserRole = 'developer' | 'admin' | 'machine_planner' | 'planner' | 'viewer';

interface AppUser {
  id: string;
  username: string;
  role: UserRole;
  display_name: string;
  password_plain: string | null;
  section_access: SectionAccess;
  created_at: string;
}

const ROLE_OPTIONS: { value: UserRole; label: string }[] = [
  { value: 'developer',       label: 'Developer' },
  { value: 'admin',           label: 'Admin' },
  { value: 'machine_planner', label: 'Machine Planner' },
  { value: 'planner',         label: 'Planner' },
  { value: 'viewer',          label: 'Viewer' },
];

const ROLE_BADGE: Record<UserRole, string> = {
  developer:       'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800',
  admin:           'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800',
  machine_planner: 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 border border-orange-200 dark:border-orange-800',
  planner:         'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800',
  viewer:          'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700',
};

const SECTION_OPTIONS: { value: SectionAccess; label: string }[] = [
  { value: 'both',              label: 'ทั้ง 2 Section' },
  { value: 'smartproduction',   label: 'Smartproduction Board' },
  { value: 'production_control', label: 'Production Control Board' },
];

const SECTION_BADGE: Record<SectionAccess, string> = {
  both:              'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800',
  smartproduction:   'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800',
  production_control:'bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800',
};

const SECTION_LABEL: Record<SectionAccess, string> = {
  both: 'ทั้ง 2 Section',
  smartproduction: 'Smartproduction',
  production_control: 'Production Control',
};

interface UserFormState {
  username: string;
  displayName: string;
  role: UserRole;
  password: string;
  sectionAccess: SectionAccess;
}

function blankForm(): UserFormState {
  return { username: '', displayName: '', role: 'planner', password: '', sectionAccess: 'both' };
}

interface UserDialogProps {
  editUser?: AppUser;
  callerRole: UserRole;
  onClose: () => void;
  onSaved: () => void;
}

function UserDialog({ editUser, callerRole, onClose, onSaved }: UserDialogProps) {
  const isEdit = !!editUser;
  const isDeveloper = callerRole === 'developer';
  const [form, setForm] = useState<UserFormState>(() =>
    editUser
      ? { username: editUser.username, displayName: editUser.display_name, role: editUser.role, password: '', sectionAccess: editUser.section_access ?? 'both' }
      : blankForm()
  );
  const [showPw, setShowPw] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');

  const selectableRoles = ROLE_OPTIONS.filter(r => isDeveloper || r.value !== 'developer');

  async function handleSave() {
    if (!form.username.trim() || !form.displayName.trim()) {
      setError('Username and Display Name are required');
      return;
    }
    if (!isEdit && !form.password.trim()) {
      setError('Password is required for new users');
      return;
    }
    if (!isDeveloper && form.role === 'developer') {
      setError('Only Developer accounts can create Developer users');
      return;
    }
    setSaving(true);
    const { error: rpcErr } = await supabase.rpc('admin_upsert_user', {
      p_username:      form.username.trim(),
      p_password:      form.password.trim(),
      p_role:          form.role,
      p_display_name:  form.displayName.trim(),
      p_section_access: form.sectionAccess,
    });
    setSaving(false);
    if (rpcErr) { setError(rpcErr.message); return; }
    onSaved();
  }

  const inputCls = 'w-full px-3 py-2 border border-gray-200 dark:border-blue-900/60 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#F36B21] bg-white dark:bg-[#091526] text-gray-800 dark:text-gray-200';

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div className="bg-white dark:bg-[#0C1830] rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div className="bg-[#0A0B0D] dark:bg-[#070D1A] px-6 py-4 flex items-center justify-between border-b border-blue-900/50">
          <div className="flex items-center gap-2">
            <User size={14} className="text-[#F36B21]" />
            <span className="text-white font-bold text-sm">{isEdit ? 'Edit User' : 'Add User'}</span>
          </div>
          <button onClick={onClose} className="text-gray-400 hover:text-white transition-colors"><X size={16} /></button>
        </div>
        <div className="p-6 flex flex-col gap-4">
          {error && <div className="text-xs text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 px-3 py-2 rounded-lg">{error}</div>}
          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Username</label>
              <input
                value={form.username}
                onChange={e => setForm(f => ({ ...f, username: e.target.value }))}
                disabled={isEdit}
                className={inputCls + (isEdit ? ' opacity-50 cursor-not-allowed' : '')}
                placeholder="username"
              />
            </div>
            <div>
              <label className="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Display Name</label>
              <input
                value={form.displayName}
                onChange={e => setForm(f => ({ ...f, displayName: e.target.value }))}
                className={inputCls}
                placeholder="Full Name"
              />
            </div>
          </div>
          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Role</label>
              <select
                value={form.role}
                onChange={e => setForm(f => ({ ...f, role: e.target.value as UserRole }))}
                className={inputCls}
              >
                {selectableRoles.map(r => (
                  <option key={r.value} value={r.value}>{r.label}</option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Section Access</label>
              <select
                value={form.sectionAccess}
                onChange={e => setForm(f => ({ ...f, sectionAccess: e.target.value as SectionAccess }))}
                className={inputCls}
              >
                {SECTION_OPTIONS.map(s => (
                  <option key={s.value} value={s.value}>{s.label}</option>
                ))}
              </select>
            </div>
          </div>
          <div>
            <label className="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">
              Password {isEdit && <span className="text-gray-400 font-normal">(leave blank to keep)</span>}
            </label>
            <div className="relative">
              <input
                type={showPw ? 'text' : 'password'}
                value={form.password}
                onChange={e => setForm(f => ({ ...f, password: e.target.value }))}
                className={inputCls + ' pr-10'}
                placeholder={isEdit ? '••••••••' : 'New password'}
              />
              <button type="button" onClick={() => setShowPw(v => !v)}
                className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
                {showPw ? <EyeOff size={14} /> : <Eye size={14} />}
              </button>
            </div>
          </div>
          <div className="flex gap-3 pt-1">
            <button
              onClick={handleSave}
              disabled={saving}
              className="flex-1 flex items-center justify-center gap-2 py-2.5 bg-[#F36B21] hover:bg-[#D4591A] text-white text-sm font-bold rounded-xl transition-all active:scale-95 disabled:opacity-50"
            >
              <Save size={14} />
              {saving ? 'Saving...' : 'Save'}
            </button>
            <button
              onClick={onClose}
              className="flex-1 py-2.5 bg-gray-100 dark:bg-[#091526] hover:bg-gray-200 dark:hover:bg-[#0C1D3A] text-gray-700 dark:text-gray-300 text-sm font-semibold rounded-xl transition-all border border-transparent dark:border-blue-900/50"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

function PasswordCell({ password, canView }: { password: string | null; canView: boolean }) {
  const [visible, setVisible] = useState(false);
  if (!canView) return <span className="text-gray-300 dark:text-gray-600 text-xs select-none">••••••••</span>;
  if (!password) return <span className="text-gray-300 dark:text-gray-600 text-xs">—</span>;
  return (
    <div className="flex items-center gap-1.5">
      <span className="font-mono text-xs text-gray-700 dark:text-gray-300 select-all">
        {visible ? password : '•'.repeat(Math.min(password.length, 10))}
      </span>
      <button
        onClick={() => setVisible(v => !v)}
        className="p-0.5 text-gray-300 hover:text-[#F36B21] transition-colors"
        title={visible ? 'ซ่อนรหัส' : 'แสดงรหัส'}
      >
        {visible ? <EyeOff size={12} /> : <Eye size={12} />}
      </button>
    </div>
  );
}

export default function UserManagement() {
  const { user: currentUser } = useAuth();
  const callerRole = (currentUser?.role ?? 'viewer') as UserRole;
  const isDeveloper = callerRole === 'developer';

  const [users, setUsers] = useState<AppUser[]>([]);
  const [loading, setLoading] = useState(true);
  const [editingUser, setEditingUser] = useState<AppUser | undefined>(undefined);
  const [showDialog, setShowDialog] = useState(false);
  const [deletingId, setDeletingId] = useState<string | null>(null);

  const fetchUsers = useCallback(async () => {
    setLoading(true);
    const { data } = await supabase.rpc('admin_list_users');
    if (data) setUsers(data as AppUser[]);
    setLoading(false);
  }, []);

  useEffect(() => { fetchUsers(); }, [fetchUsers]);

  async function deleteUser(user: AppUser) {
    if (!confirm(`Delete user "${user.display_name}" (${user.username})?`)) return;
    setDeletingId(user.id);
    await supabase.rpc('admin_delete_user', { p_username: user.username });
    await fetchUsers();
    setDeletingId(null);
  }

  function openAdd() { setEditingUser(undefined); setShowDialog(true); }
  function openEdit(u: AppUser) { setEditingUser(u); setShowDialog(true); }

  return (
    <div className="flex-1 flex flex-col min-h-0">
      {/* Toolbar */}
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center gap-2">
          <Shield size={16} className="text-[#F36B21]" />
          <span className="font-bold text-gray-800 dark:text-gray-100 text-sm">User Management</span>
          <span className="bg-gray-100 dark:bg-[#0C1830] text-gray-600 dark:text-gray-400 text-xs font-semibold px-2 py-0.5 rounded-full border border-gray-200 dark:border-blue-900/50">{users.length}</span>
        </div>
        <div className="flex items-center gap-2">
          <button
            onClick={fetchUsers}
            className="p-2 text-gray-500 dark:text-gray-400 hover:text-[#F36B21] border border-gray-200 dark:border-blue-900/50 rounded-xl bg-white dark:bg-[#0C1830] hover:bg-orange-50 dark:hover:bg-[#0C1D3A] transition-all"
          >
            <RefreshCw size={14} className={loading ? 'animate-spin' : ''} />
          </button>
          <button
            onClick={openAdd}
            className="flex items-center gap-2 px-4 py-2 bg-[#F36B21] hover:bg-[#D4591A] text-white text-sm font-bold rounded-xl transition-all active:scale-95"
          >
            <Plus size={14} /> Add User
          </button>
        </div>
      </div>

      {/* Table */}
      <div className="flex-1 overflow-auto rounded-2xl border border-gray-200 dark:border-blue-900/50 shadow-sm">
        <table className="w-full text-sm border-collapse">
          <thead>
            <tr className="bg-[#0A0B0D] dark:bg-[#070D1A] sticky top-0 z-10">
              {['Display Name', 'Username', 'Password', 'Role', 'Section', 'Created', ''].map(h => (
                <th key={h} className="text-left text-xs font-bold text-gray-400 uppercase tracking-wider px-4 py-3 border-b border-white/10 whitespace-nowrap first:pl-5">
                  {h}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td colSpan={7} className="text-center py-12"><div className="w-8 h-8 border-2 border-[#F36B21]/20 border-t-[#F36B21] rounded-full animate-spin mx-auto" /></td></tr>
            ) : users.map((user, idx) => (
              <tr key={user.id} className={`border-b border-gray-100 dark:border-blue-900/30 hover:bg-orange-50/30 dark:hover:bg-blue-900/20 group transition-colors ${idx % 2 === 0 ? 'bg-white dark:bg-[#0C1830]' : 'bg-gray-50/40 dark:bg-[#081323]'}`}>
                <td className="px-4 py-3 pl-5 font-semibold text-gray-800 dark:text-gray-200">{user.display_name}</td>
                <td className="px-4 py-3 font-mono text-gray-500 dark:text-gray-400 text-xs">{user.username}</td>
                <td className="px-4 py-3">
                  <PasswordCell password={user.password_plain} canView={isDeveloper} />
                </td>
                <td className="px-4 py-3">
                  <span className={`inline-block px-2.5 py-1 rounded-lg text-xs font-semibold ${ROLE_BADGE[user.role]}`}>
                    {ROLE_OPTIONS.find(r => r.value === user.role)?.label ?? user.role}
                  </span>
                </td>
                <td className="px-4 py-3">
                  <span className={`inline-block px-2.5 py-1 rounded-lg text-xs font-semibold ${SECTION_BADGE[user.section_access ?? 'both']}`}>
                    {SECTION_LABEL[user.section_access ?? 'both']}
                  </span>
                </td>
                <td className="px-4 py-3 text-gray-400 dark:text-gray-500 text-xs whitespace-nowrap">
                  {new Date(user.created_at).toLocaleDateString('en-GB')}
                </td>
                <td className="pr-4 py-3">
                  <div className="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-all">
                    {(isDeveloper || user.role !== 'developer') && (
                      <button
                        onClick={() => openEdit(user)}
                        className="p-1.5 text-gray-400 hover:text-[#F36B21] hover:bg-orange-50 dark:hover:bg-orange-900/20 rounded-lg transition-all"
                        title="Edit"
                      >
                        <Pencil size={14} />
                      </button>
                    )}
                    {(isDeveloper || (user.role !== 'developer' && callerRole === 'admin')) && (
                      <button
                        onClick={() => deleteUser(user)}
                        disabled={deletingId === user.id}
                        className="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-all disabled:opacity-30"
                        title="Delete"
                      >
                        <Trash2 size={14} />
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {showDialog && (
        <UserDialog
          editUser={editingUser}
          callerRole={callerRole}
          onClose={() => setShowDialog(false)}
          onSaved={() => { setShowDialog(false); fetchUsers(); }}
        />
      )}
    </div>
  );
}
</file>

