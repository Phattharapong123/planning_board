                              <button onClick={() => setEditRow(null)}
                                className="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700/30 rounded-lg transition-all" title="Cancel">
                                <X size={13}/>
                              </button>
