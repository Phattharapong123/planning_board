                         THEN p_display_name ELSE display_name END,
    password_plain = CASE WHEN p_new_password IS NOT NULL AND p_new_password <> ''
                          THEN p_new_password ELSE password_plain END
  WHERE username = p_username;
  RETURN FOUND;
END;
$$;

