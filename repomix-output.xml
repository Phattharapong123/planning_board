                            <>
                              <button onClick={() => startEdit(part)}
                                className="p-1.5 text-gray-400 hover:text-brand-orange hover:bg-brand-orange-muted dark:hover:bg-orange-900/20 rounded-lg transition-all" title="Edit">
                                <Pencil size={13}/>
