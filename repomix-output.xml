<file path="supabase/migrations/20260716091819_create_delete_log.sql">
/*
# Create delete_log table

1. New Tables
- `delete_log`
  - `id` (uuid, primary key)
  - `table_name` (text, not null) — which table the record was deleted from
  - `record_id` (uuid, not null) — the id of the deleted record
  - `order_id` (text, nullable) — the human-readable order_id (for production_orders)
  - `deleted_by` (text, not null) — username of the person who deleted the record
  - `deleted_at` (timestamptz, default now()) — when the deletion happened
  - `snapshot` (jsonb, nullable) — JSON snapshot of key fields from the deleted record
2. Security
- Enable RLS on `delete_log`.
- Allow authenticated users to read and insert (append-only audit log).
- No update or delete policies — audit entries are immutable.
3. Indexes
- Index on `deleted_at` DESC for chronological queries.
- Index on `table_name` for filtering by table.
*/

CREATE TABLE IF NOT EXISTS delete_log (
  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  table_name  text NOT NULL,
  record_id   uuid NOT NULL,
  order_id    text,
  deleted_by  text NOT NULL,
  deleted_at  timestamptz NOT NULL DEFAULT now(),
  snapshot    jsonb
);

ALTER TABLE delete_log ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "select_delete_log" ON delete_log;
CREATE POLICY "select_delete_log" ON delete_log FOR SELECT
  TO authenticated USING (true);

DROP POLICY IF EXISTS "insert_delete_log" ON delete_log;
CREATE POLICY "insert_delete_log" ON delete_log FOR INSERT
  TO authenticated WITH CHECK (true);

CREATE INDEX IF NOT EXISTS idx_delete_log_deleted_at ON delete_log (deleted_at DESC);
CREATE INDEX IF NOT EXISTS idx_delete_log_table_name ON delete_log (table_name);
</file>

<file path="supabase/migrations/20260716092955_fix_delete_log_rls_anon.sql">
/*
# Fix delete_log RLS policies to allow anon access

The app uses a custom auth system (verify_login RPC), not Supabase Auth sessions.
The frontend client always runs as the `anon` role, so policies scoped to
`authenticated` only silently block all inserts. This migration widens the
policies to include `anon`.

1. Security changes
- SELECT policy: `TO anon, authenticated` (audit log is readable by all app users)
- INSERT policy: `TO anon, authenticated` (any app user can append audit entries)
- No UPDATE or DELETE policies — entries remain immutable.
*/

DROP POLICY IF EXISTS "select_delete_log" ON delete_log;
CREATE POLICY "select_delete_log" ON delete_log FOR SELECT
  TO anon, authenticated USING (true);

DROP POLICY IF EXISTS "insert_delete_log" ON delete_log;
CREATE POLICY "insert_delete_log" ON delete_log FOR INSERT
  TO anon, authenticated WITH CHECK (true);
</file>

<file path="supabase/migrations/20260716093708_add_unc_due_qty_to_delete_log.sql">
/*
# Add unc_code, due_date, qty columns to delete_log

The user wants Order ID, UNC Code, Due date, and Qty visible as explicit columns
rather than buried in the JSONB snapshot.

1. New columns
- `unc_code` (text, nullable) — concatenated UNC codes from the deleted order
- `due_date` (date, nullable) — due date of the deleted order
- `qty` (text, nullable) — concatenated quantities from the deleted order
2. No security changes — existing RLS policies remain in effect.
*/

ALTER TABLE delete_log
  ADD COLUMN IF NOT EXISTS unc_code text,
  ADD COLUMN IF NOT EXISTS due_date date,
  ADD COLUMN IF NOT EXISTS qty text;
</file>

