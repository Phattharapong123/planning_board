-- Self-service profile update (display name + password)
CREATE OR REPLACE FUNCTION update_own_profile(
  p_username     TEXT,
  p_display_name TEXT DEFAULT NULL,
  p_new_password TEXT DEFAULT NULL
) RETURNS BOOLEAN
LANGUAGE plpgsql SECURITY DEFINER AS $$
BEGIN
  UPDATE app_users
  SET
