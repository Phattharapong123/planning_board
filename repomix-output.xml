-- Create machines master table
CREATE TABLE IF NOT EXISTS machines (
  id            uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  machine_type  text        NOT NULL DEFAULT 'FANUC',
  size_ton      integer     NOT NULL,
  mc_no         text        NOT NULL,
